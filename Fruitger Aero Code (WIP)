/* ============================================================
   FRUTIGER AERO
   ============================================================ */

:root {
  /*
   * Your wallpaper.
   * The whole theme is built around letting this remain visible.
   */
  --aero-wallpaper:
    url("https://raw.githubusercontent.com/jayzeniscoolio/MyStuff/main/skeuoss-desktop-wallpaper-2.jpg?raw=true");

  /*
   * Glass colors
   */
  --glass-blue: rgba(70, 180, 230, 0.22);
  --glass-blue-light: rgba(150, 225, 250, 0.20);
  --glass-white: rgba(255, 255, 255, 0.18);
  --glass-green: rgba(90, 190, 120, 0.10);

  /*
   * Borders
   */
  --glass-edge: rgba(255, 255, 255, 0.42);
  --glass-edge-soft: rgba(255, 255, 255, 0.20);

  /*
   * Shadows
   */
  --aero-shadow:
    0 4px 18px rgba(20, 90, 130, 0.18);

  --aero-shadow-big:
    0 12px 35px rgba(15, 90, 130, 0.25);

  /*
   * Text
   */
  --interactive-normal: #ffffff !important;
  --text-normal: #ffffff !important;
  --header-primary: #ffffff !important;
  --header-secondary: rgba(240, 255, 255, 0.90) !important;

  --text-muted:
    rgba(235, 255, 255, 0.72) !important;

  --channels-default:
    rgba(230, 255, 255, 0.76) !important;

  --channel-icon:
    rgba(230, 255, 255, 0.76) !important;

  --interactive-muted:
    rgba(235, 255, 255, 0.42) !important;
}


/* ============================================================
   WALLPAPER
   ============================================================ */

/*
 * The wallpaper is the most important part of the theme.
 *
 * Do NOT blur the whole application.
 */

html,
body {
  background-color: #65c5e8 !important;

  background-image: var(--aero-wallpaper) !important;

  background-position: center center !important;
  background-size: cover !important;
  background-repeat: no-repeat !important;
  background-attachment: fixed !important;
}


/* Discord application */

#app-mount {
  background: transparent !important;
}


